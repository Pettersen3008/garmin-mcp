{
  "name": "garmin-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Unofficial Garmin Connect SDK and MCP server for Bun",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pettersen3008/garmin-mcp.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "auth": "bun run --cwd packages/garmin-connect auth",
    "check": "oxfmt --check . && oxlint --type-aware --deny-warnings && bun run typecheck && bun test",
    "format": "oxfmt .",
    "live-check": "bun scripts/live-check.ts",
    "start": "bun run --cwd packages/garmin-mcp start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "bun install --frozen-lockfile && bun run check && bun audit"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2"
}
