{
  "name": "garmin-mcp",
  "version": "0.1.0",
  "description": "Unofficial Garmin Connect SDK and MCP server for Bun",
  "license": "MIT",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "auth": "bun run --cwd packages/garmin-connect auth",
    "check": "biome check . && bun run typecheck && bun test",
    "live-check": "bun scripts/live-check.ts",
    "start": "bun run --cwd packages/garmin-mcp start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "bun install --frozen-lockfile && bun run check && bun audit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pettersen3008/garmin-mcp.git"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
